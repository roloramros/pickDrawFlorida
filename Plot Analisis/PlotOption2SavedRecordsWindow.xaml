<Window x:Class="FloridaLotteryApp.PlotOption2SavedRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plot: Opción 2 Guardados"
        Height="790"
        Width="1150"
        WindowStartupLocation="Manual"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F3F3">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="Border" x:Key="DigitBorder">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="DigitText">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Border" x:Key="HighlightedDigitBorder" BasedOn="{StaticResource DigitBorder}"/>
        <Style TargetType="Border" x:Key="SuggestedDigitBorder" BasedOn="{StaticResource DigitBorder}"/>

        <DataTemplate x:Key="ColoredDigitTemplate">
            <Border Style="{StaticResource DigitBorder}" Background="{Binding Background}">
                <TextBlock Style="{StaticResource DigitText}" Text="{Binding Value}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StringDigitTemplate">
            <Border Style="{StaticResource HighlightedDigitBorder}">
                <TextBlock Style="{StaticResource DigitText}" Text="{Binding}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AdditionalDigitTemplate">
            <Border Style="{StaticResource SuggestedDigitBorder}">
                <TextBlock Style="{StaticResource DigitText}" Text="{Binding}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Pick3Digits}" ItemTemplate="{StaticResource ColoredDigitTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text=" " Width="20"/>

                    <ItemsControl ItemsSource="{Binding Pick4Digits}" ItemTemplate="{StaticResource ColoredDigitTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text=" " Width="20"/>

                    <ItemsControl ItemsSource="{Binding NextPick3Digits}" ItemTemplate="{StaticResource StringDigitTemplate}" Tag="{Binding NextPick3Tag}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text=" " Width="30"/>

                    <TextBlock Text="{Binding DrawIcon}"
                               FontSize="24"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding DateText}"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ItemsControl ItemsSource="{Binding AdditionalDigits}" ItemTemplate="{StaticResource AdditionalDigitTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SessionTemplate">
            <Border Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,0,26">
                <Grid>
                    <Canvas Tag="{Binding SessionTag}"
                            IsHitTestVisible="False"
                            Panel.ZIndex="10"/>
                    <StackPanel>
                        <ContentControl Content="{Binding Row1}" ContentTemplate="{StaticResource RowTemplate}" Margin="0,0,0,30"/>
                        <ContentControl Content="{Binding Row2}" ContentTemplate="{StaticResource RowTemplate}" Margin="0,0,0,30"/>
                        <Rectangle Height="1" Fill="#999696" Margin="0,8,0,8"/>
                        <ContentControl Content="{Binding Row3}" ContentTemplate="{StaticResource RowTemplate}" Margin="0,0,0,30"/>
                        <ContentControl Content="{Binding Row4}" ContentTemplate="{StaticResource RowTemplate}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionTemplate}"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,8,0,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ResultsCounterText"
                           Grid.Column="0"
                           Text="0 de 0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        Background="Transparent"
                        BorderBrush="#4A4A4A"
                        BorderThickness="1"
                        ToolTipService.InitialShowDelay="150"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.ShowDuration="20000"
                        Visibility="{Binding HasCurrentNote, Converter={StaticResource BoolToVisibility}}">
                    <Border.ToolTip>
                        <ToolTip Content="{Binding CurrentNote}"/>
                    </Border.ToolTip>
                    <TextBlock Text="i"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,4">
                <Button x:Name="DeleteButton"
                        Content="Borrar"
                        Width="120"
                        Height="34"
                        Margin="0,0,12,0"
                        Click="Delete_Click"/>
                <Button x:Name="AnteriorButton"
                        Content="Anterior"
                        Width="120"
                        Height="34"
                        Margin="0,0,12,0"
                        Click="Anterior_Click"/>
                <Button x:Name="SiguienteButton"
                        Content="Siguiente"
                        Width="120"
                        Height="34"
                        Click="Siguiente_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
