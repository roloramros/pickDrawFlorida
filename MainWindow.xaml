<Window x:Class="FloridaLotteryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Florida Lottery App"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Height="720"
        Width="1500">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="PillButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2D8CFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CFCFCF"/>
                                <Setter Property="Foreground" Value="#7A7A7A"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BluePillButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Background" Value="#2A90FF"/>
        </Style>

        <Style x:Key="PurplePillButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Background" Value="#8B2ED6"/>
        </Style>

        <Style x:Key="GreenPillButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Background" Value="#43B94A"/>
        </Style>

        <Style x:Key="PageInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#B8C7D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="CardIconButtonBase" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#8F8F8F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ECECEC"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D2D2D2"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardViewButton" TargetType="Button" BasedOn="{StaticResource CardIconButtonBase}">
        </Style>

        <Style x:Key="CardEditButton" TargetType="Button" BasedOn="{StaticResource CardIconButtonBase}">
        </Style>

        <Style x:Key="CardDeleteButton" TargetType="Button" BasedOn="{StaticResource CardIconButtonBase}">
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="Histórico (por fecha)"
                       FontSize="20"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                

                <!-- Botones -->
                <Button Content="Análisis Guardados"
                        Style="{StaticResource BluePillButton}"
                        Margin="0,0,10,0"
                        Click="Analysis_Click"/>

                <Button Content="Añadir registro"
                        Style="{StaticResource PurplePillButton}"
                        Margin="0,0,10,0"
                        Click="AddManual_Click"/>

                <Button Content="Buscar"
                        Style="{StaticResource GreenPillButton}"
                        Click="Search_Click"/>

            </StackPanel>

        </DockPanel>

        <!-- Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DayCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230"
                                CornerRadius="14"
                                BorderBrush="#22000000"
                                BorderThickness="1"
                                Padding="10"
                                Margin="0,0,12,12"
                                Background="#dad9d9f2">

                            <StackPanel> 

                                <!-- Mediodía -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="☀️" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Mediodía "
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Cursor="Hand"
                                               ToolTip="Más opciones de Mediodía"
                                               MouseLeftButtonUp="CardDateMenu_MouseLeftButtonUp">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Analisis: Plot" Tag="M" Click="AnalysisPlot_Click"/>
                                                <MenuItem Header="Función 2 (próximamente)" IsEnabled="False"/>
                                                <Separator/>
                                                <MenuItem Header="Programar nuevas funciones..." IsEnabled="False"/>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                    <Button Content="👁️"
                                            Style="{StaticResource CardViewButton}"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding P3_M_Analyzable, Converter={StaticResource BoolToVisibility}}"
                                            Click="Analysis_Midday_Click"/>
                                    <Button Content="✏️"
                                            Style="{StaticResource CardEditButton}"
                                            Margin="8,0,0,0"
                                            Tag="M"
                                            IsEnabled="{Binding M_Exists}"
                                            Click="Edit_Draw_Click"/>
                                    <Button Content="🗑️"
                                            Style="{StaticResource CardDeleteButton}"
                                            Tag="M"
                                            IsEnabled="{Binding M_Exists}"
                                            Click="Delete_Draw_Click"/>
                                </StackPanel>

                                <Grid Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pick3 -->
                                    <StackPanel Grid.Column="0">
                                    <TextBlock Text="Pick 3" Opacity="0.7" HorizontalAlignment="Center" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    BorderThickness="2" BorderBrush="Black">
                                                <TextBlock Text="{Binding P3_M_Number}"
                                                        FontSize="14" FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Pick4 -->
                                    <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pick 4" Opacity="0.7" HorizontalAlignment="Center" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            
                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    BorderThickness="2" BorderBrush="Black">
                                                <TextBlock Text="{Binding P4_M_First2}"
                                                        FontSize="14" FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </Border>

                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    BorderThickness="2" BorderBrush="Black"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding P4_M_Last2}"
                                                        FontSize="14" FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Separator/>

                                <!-- Noche -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                    <TextBlock Text="🌙" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Noche  "
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Cursor="Hand"
                                               ToolTip="Más opciones de Noche"
                                               MouseLeftButtonUp="CardDateMenu_MouseLeftButtonUp">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Analisis: Plot" Tag="E" Click="AnalysisPlot_Click"/>
                                                <MenuItem Header="Función 2 (próximamente)" IsEnabled="False"/>
                                                <Separator/>
                                                <MenuItem Header="Programar nuevas funciones..." IsEnabled="False"/>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                     <Button Content="👁️"
                                         Style="{StaticResource CardViewButton}"
                                         HorizontalAlignment="Right"
                                         Visibility="{Binding P3_E_Analyzable, Converter={StaticResource BoolToVisibility}}"
                                         Click="Analysis_Night_Click"/>
                                     <Button Content="✏️"
                                            Style="{StaticResource CardEditButton}"
                                            Margin="8,0,0,0"
                                            Tag="E"
                                            IsEnabled="{Binding E_Exists}"
                                            Click="Edit_Draw_Click"/>
                                     <Button Content="🗑️"
                                            Style="{StaticResource CardDeleteButton}"
                                            Tag="E"
                                            IsEnabled="{Binding E_Exists}"
                                            Click="Delete_Draw_Click"/>
                                </StackPanel>

                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pick3 -->
                                    <StackPanel Grid.Column="0">
                                    <TextBlock Text="Pick 3" Opacity="0.7" HorizontalAlignment="Center" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    BorderThickness="2" BorderBrush="Black">
                                                <TextBlock Text="{Binding P3_E_Number}"
                                                        FontSize="14" FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Pick4 -->
                                    <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pick 4" Opacity="0.7" HorizontalAlignment="Center" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    BorderThickness="2" BorderBrush="Black">
                                                <TextBlock Text="{Binding P4_E_First2}"
                                                        FontSize="14" FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </Border>

                                            <Border Width="48" Height="48" CornerRadius="24"
                                                    BorderThickness="2" BorderBrush="Black"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding P4_E_Last2}"
                                                        FontSize="14" FontWeight="Bold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                

                                <TextBlock Text="{Binding DateText}"
                                          HorizontalAlignment="Right"
                                          Opacity="0.8"
                                          FontWeight="Bold"
                                          FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

        <!-- Pagination -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Content="⟵ Anterior"
                        Style="{StaticResource BluePillButton}"
                        Margin="0,0,10,0"
                        IsEnabled="{Binding CanPrev}"
                        Click="Prev_Click"/>
                <TextBlock Text="{Binding PageText}"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
                <TextBlock Text="Ir a página:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBox x:Name="PageInput"
                         Style="{StaticResource PageInputStyle}"
                         Width="40"
                         KeyDown="PageInput_KeyDown"/>
                <Button Content="Siguiente ⟶"
                        Style="{StaticResource GreenPillButton}"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding CanNext}"
                        Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

