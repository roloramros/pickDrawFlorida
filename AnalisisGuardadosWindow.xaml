<!-- AnalisisGuardadosWindow.xaml -->
<Window x:Class="FloridaLotteryApp.AnalisisGuardadosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Análisis Guardados"
        Height="550"
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F3F3"
        MinHeight="400"
        MinWidth="600">
    
    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="StyledComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <ContextMenu x:Key="FolderRowContextMenu">
            <MenuItem Header="Abrir" Click="Abrir_Click"/>
            <MenuItem Header="Borrar" Click="Borrar_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panel superior con selector -->
        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Tipo de análisis:" 
                           VerticalAlignment="Center" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Margin="0,0,15,0"/>

                <ComboBox Grid.Column="1" 
                          x:Name="AnalisisComboBox"
                          Style="{StaticResource StyledComboBox}"
                          SelectionChanged="AnalisisComboBox_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Tabla de folders -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="8" 
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <DataGrid x:Name="FoldersDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                RowHeight="40"
                FontSize="13"
                AlternatingRowBackground="#F9F9F9"
                Background="White"
                HeadersVisibility="Column"
                SelectionChanged="FoldersDataGrid_SelectionChanged"
                PreviewMouseRightButtonDown="FoldersDataGrid_PreviewMouseRightButtonDown">
             
             <DataGrid.Columns>
                <DataGridTextColumn Header="Folder" 
                                    Binding="{Binding Folder}" 
                                    Width="*"/>
                <DataGridTextColumn Header="Label" 
                                    Binding="{Binding Label}" 
                                    Width="*"/>
            </DataGrid.Columns>
            
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="ContextMenu" Value="{StaticResource FolderRowContextMenu}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
        </Border>

        <!-- Panel inferior con contador y botón cerrar -->
        <Border Grid.Row="2" 
                Margin="0,15,0,0"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ContadorTextBlock"
                           Grid.Column="0"
                           Text="0 folders"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#666666"/>

                <Button Grid.Column="2"
                        Content="Cerrar"
                        Width="100"
                        Height="34"
                        Click="Cerrar_Click"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
